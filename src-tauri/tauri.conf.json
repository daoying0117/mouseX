{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseX",
  "version": "1.0.0",
  "identifier": "com.mousex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-ui",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MouseX",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
